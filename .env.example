# Copy file ini jadi ".env" (jangan commit .env ke git), lalu isi 3 value di bawah.

# OAuth Client ID dari Google Cloud Console (APIs & Services > Credentials)
# Bentuknya: xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# ID folder Google Drive "Checksheet" (berisi 10 folder kategori bangunan)
# Ambil dari URL folder: https://drive.google.com/drive/folders/<ID_INI>
VITE_ROOT_CHECKSHEET_FOLDER_ID=

# ID folder Google Drive "Instrumen"
VITE_ROOT_INSTRUMEN_FOLDER_ID=

# ID folder Google Drive "Dokumentasi Kegiatan" (struktur: Bulan > Site (tanggal) > file)
VITE_ROOT_DOKUMENTASI_FOLDER_ID=

# ID folder untuk fitur "Masuk/Keluar Jalur" (foto + rekaman suara konfirmasi
# personil & peralatan pas masuk/keluar restricted area) - 4 folder terpisah,
# ambil dari URL masing-masing: https://drive.google.com/drive/folders/<ID_INI>
VITE_FOTO_MASUK_JALUR_FOLDER_ID=
VITE_FOTO_KELUAR_JALUR_FOLDER_ID=
VITE_REKAMAN_MASUK_JALUR_FOLDER_ID=
VITE_REKAMAN_KELUAR_JALUR_FOLDER_ID=

# ID folder Google Drive tempat file bulanan "Jadwal Kunjungan MR <Bulan> <Tahun>"
# disimpan - dipakai Dashboard buat rangkum rencana & progress kerja bulan ini.
# Ambil dari URL folder: https://drive.google.com/drive/folders/<ID_INI>
VITE_JADWAL_KUNJUNGAN_FOLDER_ID=

# ID FILE (bukan folder) spreadsheet Log Gangguan - dipakai Dashboard buat
# nampilin daftar temuan & gangguan yang bisa difilter per bulan/sheet(tab).
VITE_LOG_GANGGUAN_FILE_ID=
